# Copy this file to .env (git-ignored) and fill in what you need; spenddat loads it
# automatically. Real environment variables take precedence over .env.

# ---- runtime mode --------------------------------------------------------------------
SPENDDAT_MODE=sandbox                 # sandbox | live
# SPENDDAT_LIVE_CONFIRM=I_ACCEPT_REAL_PURCHASES   # required in live mode

# ---- files ---------------------------------------------------------------------------
SPENDDAT_DB=data/spenddat.db
SPENDDAT_POLICY_FILE=policies/default.yaml
SPENDDAT_VENDORS_FILE=config/vendors.yaml
SPENDDAT_PROFILE_FILE=config/profile.yaml

# ---- absolute circuit breakers (cents); independent of policy, cannot be approved past --
SPENDDAT_HARD_MAX_TRANSACTION_MINOR=20000
SPENDDAT_HARD_MAX_DAILY_MINOR=30000
SPENDDAT_HARD_MAX_WEEKLY_MINOR=75000

# ---- backends ------------------------------------------------------------------------
SPENDDAT_PAYMENT_BACKEND=stripe       # stripe | fake (fake: sandbox only)
# Model used to understand requests. auto = OpenRouter if its key is set, else Anthropic.
SPENDDAT_LLM_PROVIDER=auto            # auto | openrouter | anthropic
# SPENDDAT_LLM_MODEL=anthropic/claude-sonnet-5.5   # OpenRouter ids are prefixed
#                                                   # (cheaper: anthropic/claude-haiku-4.5)
SPENDDAT_SECRETS_BACKEND=env          # env | command
# SPENDDAT_SECRETS_COMMAND="op read op://spenddat/{mode}_{name}/credential"

# ---- secrets (env backend). Prefer a secrets manager; never commit real values. ------
# SPENDDAT_SANDBOX_STRIPE_SECRET_KEY=sk_test_...
# SPENDDAT_SANDBOX_STRIPE_PAYMENT_METHOD_ID=pm_...
# SPENDDAT_SANDBOX_OPENROUTER_API_KEY=sk-or-...
# SPENDDAT_SANDBOX_ANTHROPIC_API_KEY=sk-ant-...
# SPENDDAT_SANDBOX_ACP_MERCHANT_API_KEY=merchant_test_key
# SPENDDAT_SANDBOX_APPROVAL_WEBHOOK_URL=https://hooks.slack.com/services/...
# SPENDDAT_LIVE_STRIPE_SECRET_KEY=rk_live_...
# SPENDDAT_LIVE_STRIPE_PAYMENT_METHOD_ID=pm_...
# SPENDDAT_LIVE_ANTHROPIC_API_KEY=sk-ant-...
# SPENDDAT_LIVE_ACP_MERCHANT_API_KEY=...
# SPENDDAT_LIVE_APPROVAL_WEBHOOK_URL=https://hooks.slack.com/services/...
